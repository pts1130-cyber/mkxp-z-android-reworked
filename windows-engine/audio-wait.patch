@@ -81,6 +81,7 @@ private:
 	std::unordered_set<std::string> arcPending;
 	std::vector<std::shared_ptr<ArcDecodedSound> > arcDone;
 	std::thread arcWorker;
+	std::string arcActive;
 	bool arcQuit;
 };
 
