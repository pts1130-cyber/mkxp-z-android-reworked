+IntRect Bitmap::alphaBounds(int threshold, const IntRect &region) const
+{
+    guardDisposed();
+
+    GUARD_MEGA;
+    GUARD_ANIMATED;
+
+    int x0 = clamp<int>(region.x, 0, width());
+    int y0 = clamp<int>(region.y, 0, height());
+    int x1 = (int) std::min<long long>((long long) region.x + region.w, width());
+    int y1 = (int) std::min<long long>((long long) region.y + region.h, height());
+    x1 = std::max(x1, 0);
+    y1 = std::max(y1, 0);
+
+    if (x1 <= x0 || y1 <= y0)
+        return IntRect(0, 0, 0, 0);
+
+    if (!p->surface)
+    {
+        p->allocSurface();
+
+        FBO::bind(p->gl.fbo);
+
+        glState.viewport.pushSet(IntRect(0, 0, width(), height()));
+
+        gl.ReadPixels(0, 0, width(), height(), GL_RGBA, GL_UNSIGNED_BYTE, p->surface->pixels);
+
+        glState.viewport.pop();
+    }
+
+    const uint32_t aMask = 0xFFu << p->format->Ashift;
+    const uint32_t aShift = p->format->Ashift;
+    const uint32_t limit = (uint32_t) clamp<int>(threshold, 0, 255);
+
+    int minX = x1, minY = y1, maxX = -1, maxY = -1;
+
+    for (int y = y0; y < y1; ++y)
+    {
+        const uint32_t *row = (const uint32_t *) ((const uint8_t *) p->surface->pixels + y * p->surface->pitch);
+
+        for (int x = x0; x < x1; ++x)
+        {
+            if (((row[x] & aMask) >> aShift) > limit)
+            {
+                if (x < minX) minX = x;
+                if (x > maxX) maxX = x;
+                if (y < minY) minY = y;
+                maxY = y;
+            }
+        }
+    }
+
+    if (maxX < 0)
+        return IntRect(0, 0, 0, 0);
+
+    return IntRect(minX, minY, maxX - minX + 1, maxY - minY + 1);
+}
