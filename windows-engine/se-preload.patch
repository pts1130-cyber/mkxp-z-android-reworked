+/* Decodes image files on a worker thread ahead of time (Bitmap.preload), so the
+ * game thread only has to upload the texture when Bitmap.new gets the same name. */
+struct ArcImageHandler : FileSystem::OpenHandler
+{
+    SDL_Surface *surface;
+
+    ArcImageHandler() : surface(0) {}
+
+    bool tryRead(SDL_RWops &ops, const char *ext)
+    {
+        if (IMG_isGIF(&ops))
+            return false;
+
+        surface = IMG_LoadTyped_RW(&ops, 1, ext);
+        return surface != 0;
+    }
+};
+
+struct ArcImagePreload
+{
+    static const size_t MAX_BYTES = 192u * 1024u * 1024u;
+
+    std::mutex lock;
+    std::condition_variable cond;
+    std::deque<std::string> queue;
+    std::unordered_set<std::string> pending;
+    std::unordered_map<std::string, SDL_Surface *> done;
+    size_t doneBytes;
+    std::thread worker;
+    bool quit;
+
+    ArcImagePreload() : doneBytes(0), quit(false) {}
+
+    ~ArcImagePreload()
+    {
+        {
+            std::lock_guard<std::mutex> l(lock);
+            quit = true;
+        }
+        cond.notify_all();
+        if (worker.joinable())
+            worker.join();
+    }
+
+    void run()
+    {
+        for (;;)
+        {
+            std::string name;
+
+            {
+                std::unique_lock<std::mutex> l(lock);
+                cond.wait(l, [this] { return quit || !queue.empty(); });
+
+                if (quit)
+                    return;
+
+                name = queue.front();
+                queue.pop_front();
+            }
+
+            SDL_Surface *surf = 0;
+
+            try
+            {
+                ArcImageHandler handler;
+                shState->fileSystem().openRead(handler, name.c_str());
+                surf = handler.surface;
+            }
+            catch (...)
+            {
+            }
+
+            {
+                std::lock_guard<std::mutex> l(lock);
+
+                if (surf)
+                {
+                    size_t bytes = (size_t) surf->pitch * surf->h;
+
+                    if (doneBytes + bytes <= MAX_BYTES && !done.count(name))
+                    {
+                        done[name] = surf;
+                        doneBytes += bytes;
+                    }
+                    else
+                    {
+                        SDL_FreeSurface(surf);
+                    }
+                }
+
+                pending.erase(name);
+            }
+
+            cond.notify_all();
+        }
+    }
+
+    void request(const std::string &name)
+    {
+        {
+            std::lock_guard<std::mutex> l(lock);
+
+            if (quit || pending.count(name) || done.count(name))
+                return;
+
+            pending.insert(name);
+            queue.push_back(name);
+
+            if (!worker.joinable())
+                worker = std::thread(&ArcImagePreload::run, this);
+        }
+
+        cond.notify_all();
+    }
+
+    /* Returns the decoded surface (caller owns it) or 0. Waits if the
+     * worker is decoding exactly this file right now. */
+    SDL_Surface *take(const std::string &name)
+    {
+        std::unique_lock<std::mutex> l(lock);
+
+        if (pending.count(name))
+            cond.wait(l, [this, &name] { return pending.count(name) == 0; });
+
+        auto it = done.find(name);
+
+        if (it == done.end())
+            return 0;
+
+        SDL_Surface *surf = it->second;
+        doneBytes -= (size_t) surf->pitch * surf->h;
+        done.erase(it);
+
+        return surf;
+    }
+};
+
+static ArcImagePreload &arcImagePreload()
+{
+    static ArcImagePreload instance;
+    return instance;
+}
+
+void Bitmap::preload(const char *filename)
+{
+    arcImagePreload().request(filename);
+}
