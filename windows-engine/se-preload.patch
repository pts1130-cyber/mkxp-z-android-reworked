+		arcPending.insert(filename);
+		arcQueue.push_back(filename);
+
+		if (!arcWorker.joinable())
+			arcWorker = std::thread(&SoundEmitter::workerMain, this);
+	}
+
+	arcCond.notify_all();
+}
