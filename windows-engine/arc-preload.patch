     RB_UNUSED_PARAM;
 
-    const char *filename;
-    rb_get_args(argc, argv, "z", &filename RB_ARG_END);
-    Bitmap::preload(filename);
+    /* same call forms as the Android engine: paths or arrays of paths, then an optional Integer scale */
+    int scale = 1;
+    int n = argc;
+    if (n > 0 && FIXNUM_P(argv[n - 1])) {
+        scale = NUM2INT(argv[n - 1]);
+        --n;
+    }
+
+    for (int i = 0; i < n; ++i) {
+        VALUE arg = argv[i];
+        if (RB_TYPE_P(arg, T_ARRAY)) {
+            long m = RARRAY_LEN(arg);
+            for (long j = 0; j < m; ++j) {
+                VALUE e = rb_ary_entry(arg, j);
+                if (RB_TYPE_P(e, T_STRING))
+                    Bitmap::preload(StringValueCStr(e), scale);
+            }
+        } else if (RB_TYPE_P(arg, T_STRING)) {
+            Bitmap::preload(StringValueCStr(arg), scale);
+        }
+    }
+
+    return Qnil;
+}
+
+RB_METHOD(bitmapPreloadLimits) {
+    RB_UNUSED_PARAM;
+
+    int maxDone = 0;
+    unsigned long long maxBytes = 0;
+    Bitmap::preloadLimits(&maxDone, &maxBytes);
 
+    return rb_ary_new3(2, INT2NUM(maxDone), ULL2NUM(maxBytes));
+}
+
+RB_METHOD(bitmapPreloadClear) {
+    RB_UNUSED_PARAM;
+    Bitmap::preloadClear();
     return Qnil;
 }
 
