-void Bitmap::preload(const char *filename)
+void Bitmap::preload(const char *filename, int logicalScale)
 {
+    /* this engine has no logical-scale loading: Bitmap.new(path, n) does not exist,
+     * so a request for 1/n pixels could never be taken */
+    if (!filename || !*filename || logicalScale > 1)
+        return;
+
     arcImagePreload().request(filename);
 }
 
+void Bitmap::preloadClear()
+{
+    arcImagePreload().clear();
+}
+
+void Bitmap::preloadLimits(int *maxDone, unsigned long long *maxBytes)
+{
+    if (maxDone)
+        *maxDone = (int) ArcImagePreload::MAX_DONE;
+    if (maxBytes)
+        *maxBytes = (unsigned long long) ArcImagePreload::MAX_BYTES;
+}
