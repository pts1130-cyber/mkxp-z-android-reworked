+static bool meshReadFloats(VALUE v)
+{
+    static const long cap = 2L * (Sprite::MeshMaxCells + 1) * (Sprite::MeshMaxCells + 1);
+    
+    meshScratch.clear();
+    if (NIL_P(v))
