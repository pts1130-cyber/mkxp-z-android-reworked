+    RB_UNUSED_PARAM;
+
+    rb_check_argc(argc, 0);
+
+    Bitmap *b = getPrivateData<Bitmap>(self);
+
+    bool ret = b->getSmooth();
+    return rb_bool_new(ret);
+}
+RB_METHOD_GUARD_END
+
+RB_METHOD_GUARD(bitmapSetSmooth){
+    RB_UNUSED_PARAM;
+
+    bool value;
+    rb_get_args(argc, argv, "b", &value RB_ARG_END);
+
+    Bitmap *b = getPrivateData<Bitmap>(self);
+
+    b->setSmooth(value);
